    "Dates up to today are recorded as real entries. Later dates are shown as forecasts until they arrive." : {
      "extractionState" : "manual",
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu günə qədərki tarixlər real qeyd kimi yazılır. Sonrakı tarixlər gələnə qədər proqnoz kimi göstərilir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даты до сегодняшнего дня записываются как реальные. Более поздние показываются как прогноз."
          }
        }
      }
    },
